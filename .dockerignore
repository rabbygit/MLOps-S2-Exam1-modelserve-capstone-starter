# Local Python environment + build artefacts
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Datasets. Big and only used by training/train.py on the host.
fraud-detection/

# MLflow local backend (only created when running the server outside docker).
mlruns/
mlflow.db
mlartifacts/

# Feast generated state.
feast_repo/data/online_store.db
# feast_repo/data/registry.db is intentionally NOT ignored: the inference
# image needs it to serve predictions.

# Secrets, host-only env
.env
.env.local
.env.*.local
*.pem
*.key

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Git internals (docker doesn't need them)
.git/
.gitignore
.github/

# Pulumi
infrastructure/.pulumi/
infrastructure/Pulumi.*.yaml
infrastructure/node_modules/

# Docs
docs/
README.md
*.md

# Test outputs
.coverage
htmlcov/
