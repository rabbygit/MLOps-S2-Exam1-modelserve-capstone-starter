# Copy to .env (gitignored) and adjust as needed.
#
# Two readers:
#   1. Host-side scripts (training/train.py, scripts/materialize_features.py)
#      load this via python-dotenv. They run on YOUR machine, so hostnames
#      are localhost and paths are relative to the project root.
#   2. docker compose auto-reads .env for ${VAR} substitution in
#      docker-compose.yml. Compose uses these for context-agnostic things
#      like POSTGRES_USER. Hostname-dependent values (mlflow:5000,
#      redis:6379) are set explicitly in each service's `environment:`
#      block — they do NOT come from this file.

# ---------------------------------------------------------------------------
# Postgres (used by compose for ${VAR} substitution; not read by host scripts)
# ---------------------------------------------------------------------------
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# ---------------------------------------------------------------------------
# MLflow (host context — for training/train.py)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection

# ---------------------------------------------------------------------------
# Model Registry (consumed by training/train.py and FastAPI)
# ---------------------------------------------------------------------------
MODEL_NAME=fraud-detector
MODEL_STAGE=Production

# ---------------------------------------------------------------------------
# Feast (host context — for scripts/materialize_features.py)
# ---------------------------------------------------------------------------
FEAST_REPO_PATH=feast_repo
REDIS_CONNECTION_STRING=localhost:6379

# ---------------------------------------------------------------------------
# Training script
# ---------------------------------------------------------------------------
FRAUD_DATA_PATH=fraud-detection/fraudTrain.csv
SAMPLE_SIZE=200000

# ---------------------------------------------------------------------------
# AWS — used in Sessions 5-7 (Pulumi + S3 + ECR). Leave blank for S1-2.
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Grafana — used in Sessions 3-4
# ---------------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=admin
